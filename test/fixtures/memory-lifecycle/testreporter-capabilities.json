        "consumerKey": "keep"
      },
      {
        "path": "meta_decision_layer_choice.md",
        "enabled": true
      },
      {
        "path": "meta_memory_lifecycle.md",
        "enabled": true
      }
    ],
    "templatesSeeded": true,
    "consumerLifecycleKey": {
      "keep": true
    }
  }
}
