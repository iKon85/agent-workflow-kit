{
  "schemaVersion": 1,
  "consumerTopLevel": {
    "keep": "exactly"
  },
  "memoryLifecycle": {
    "enabled": false,
    "activeRoot": ".memory/active",
    "archiveRoot": ".memory/archive",
    "receiptRoot": ".memory/receipts",
    "approvals": {
      "restore": true,
      "prune": false,
      "consumerApprovalKey": "keep"
    },
    "memories": [
      {
        "path": "MEMORY.md",
