{
  "version": 1,
  "worktreeLifecycle": {
    "enabled": true,
    "worktreeRoot": ".worktrees",
    "branchTemplate": "{type}/{issue}-{slug}",
    "pathTemplate": "{type}-{issue}-{slug}",
    "branchRegex": "^(?:feat|fix)/(?P<issue>\\d+)-",
    "mainBranches": ["main"],
    "protectedBranches": ["main"],
    "setupEntry": "./scripts/setup-worktree.sh",
    "seed": {
      "paths": [".env", ".env.local"],
      "variables": {
        "VITE_DEV_PORT": 5173,
        "BACKEND_PORT": 3001
      }
    }
  }
}
