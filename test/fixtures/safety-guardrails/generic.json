{
  "version": 1,
  "safetyGuardrails": {
    "choice": "yes",
    "enabled": true,
    "secrets": {
      "enabled": true,
      "sensitiveNames": [
        ".env",
        "credentials.json"
      ],
      "sensitivePathFragments": [
        "private/"
      ],
      "safeTemplateSuffixes": [
        ".example"
      ]
    },
    "packageManager": {
      "enabled": true,
      "lockfiles": {
        "yarn.lock": "yarn"
      }
    },
    "doubleBackground": {
      "enabled": false,
      "surfaces": []
    },
    "searchShim": {
      "enabled": false,
      "commandNames": [],
      "detected": false
    },
    "repositorySecurity": {
      "gitHooks": {
        "enabled": false,
        "hooksPath": ".hooks"
      },
      "gitleaks": {
        "enabled": true,
        "required": true
      },
      "dependencyAudit": {
        "enabled": true,
        "packageManager": "yarn",
        "outagePolicy": "block",
        "blockSeverities": [
          "high",
          "critical"
        ]
      }
    }
  }
}
