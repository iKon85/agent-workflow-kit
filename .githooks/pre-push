#!/usr/bin/env bash
# pre-push — native git hook (zero-dep).
#
# Wired via `git config core.hooksPath .githooks` (see CLAUDE.md §Development).
# Runs the full local suite before code can leave the machine. A push that only
# deletes unprotected remote refs cannot introduce code, so it takes the
# deterministic protected-ref check below instead.

set -euo pipefail

# Git exports GIT_DIR & co. to hooks; the suite's child tests run git in their
# own temp repos and must not inherit them (see pre-commit).
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX

has_evidence=false
all_deletions=true
malformed=false
protected_deletion=

# Git supplies one row per ref update on stdin:
# <local-ref> <local-sha> <remote-ref> <remote-sha>
# Consume the complete stream before deciding so a delete cannot hide a later
# create/update in the same push.
while IFS= read -r update || [[ -n "$update" ]]; do
  has_evidence=true
  read -r -a fields <<< "$update"
  if [[ "${#fields[@]}" -ne 4 ]]; then
    malformed=true
    all_deletions=false
    continue
  fi

  local_ref="${fields[0]}"
  local_sha="${fields[1]}"
  remote_ref="${fields[2]}"
  remote_sha="${fields[3]}"

  if [[ ! "$local_ref" =~ ^(\(delete\)|refs/.+)$ ]] \
    || [[ ! "$remote_ref" =~ ^refs/.+$ ]] \
    || [[ ! "$local_sha" =~ ^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$ ]] \
    || [[ ! "$remote_sha" =~ ^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$ ]]; then
    malformed=true
    all_deletions=false
    continue
  fi

  if [[ ! "$local_sha" =~ ^0+$ ]]; then
    all_deletions=false
    continue
  fi

  # main is protected by the repository ruleset. Tags are release identities:
  # deleting any of them is never a cleanup operation.
  if [[ "$remote_ref" == "refs/heads/main" || "$remote_ref" == refs/tags/* ]]; then
    protected_deletion="$remote_ref"
  fi
done

if [[ "$has_evidence" == true && "$malformed" == false && "$all_deletions" == true ]]; then
  if [[ -n "$protected_deletion" ]]; then
    echo "❌ refusing deletion of protected ref: $protected_deletion" >&2
    exit 1
  fi
  echo "✅ deletion-only push passed protected-ref safety; full suite skipped."
  exit 0
fi

if ! command -v npm >/dev/null 2>&1; then
  echo "❌ npm missing — Node ≥ 20 required. Install it, then push again. NEVER --no-verify."
  exit 1
fi

npm test

echo "✅ pre-push suite passed."
