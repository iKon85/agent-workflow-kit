node_modules/
# No lockfile is tracked. pnpm-lock.yaml was already ignored; npm is the
# documented package manager here, so `npm install` would otherwise leave an
# untracked package-lock.json for the next session to commit by accident.
pnpm-lock.yaml
package-lock.json
dist-kit/
__pycache__/

# Planning artifacts. Skills and CLAUDE.md describe these as on-disk only; the
# rules below make that true. Without them every planning worktree reports a
# permanently dirty tree, which the worktree-lifecycle cleanup treats as
# terminal (#254).
PLAN.md
PLAN-REVIEW-LOG.md
ANNAHMEN.md

# NOT ignored on purpose: `.worktrees/`, and tool/prototype scratch in the
# repository root. 0.45.1 ignored them to unblock a landing; ten minutes later
# teardown deleted a parallel session's live worktree, because ignored means
# "deletable scratch" and nothing checked that the deletion target was the main
# checkout (#385). Until that is fixed, an untracked sibling worktree BLOCKING a
# landing is the safe failure and deleting it is not. Re-adding these entries
# needs #385 closed first; the embedded-repo hazard they addressed (#370) is
# visible in a diff and reversible, which the data loss is not.

# Local Claude/Codex state and personal overrides. Checked-in skills, project
# config, hooks, and agent definitions remain trackable.
.claude/settings.local.json
.claude/settings.local.json.backup
.codex/*.local.toml
.codex/agents/*.local.toml
.codex/auth.json
.codex/history.jsonl
.codex/session-*.jsonl
.codex/logs/
.codex/cache/
.codex/tmp/
.codex-log/

.claude/logs/
