node_modules/
# No lockfile is tracked. pnpm-lock.yaml was already ignored; npm is the
# documented package manager here, so `npm install` would otherwise leave an
# untracked package-lock.json for the next session to commit by accident.
pnpm-lock.yaml
package-lock.json
dist-kit/
__pycache__/

# Planning artifacts. Skills and CLAUDE.md describe these as on-disk only; the
# rules below make that true. Without them every planning worktree reports a
# permanently dirty tree, which the worktree-lifecycle cleanup treats as
# terminal (#254).
PLAN.md
PLAN-REVIEW-LOG.md
ANNAHMEN.md

# Linked worktrees. CLAUDE.md places them at `.worktrees/<slug>`, so the parent
# checkout sees a live sibling worktree as an untracked directory: it blocks
# every landing from the main tree and a wholesale `git add` commits it as an
# embedded repository (#370).
.worktrees/

# Tool and prototype scratch. `/prototype` and the Playwright MCP server write
# these into the repository root; ignoring them is what makes them deletable at
# teardown, which is this repo's only mechanism for that.
.playwright-mcp/
variant-*.png

# Local Claude/Codex state and personal overrides. Checked-in skills, project
# config, hooks, and agent definitions remain trackable.
.claude/settings.local.json
.claude/settings.local.json.backup
.codex/*.local.toml
.codex/agents/*.local.toml
.codex/auth.json
.codex/history.jsonl
.codex/session-*.jsonl
.codex/logs/
.codex/cache/
.codex/tmp/
.codex-log/

.claude/logs/
