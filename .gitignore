node_modules/
# No lockfile is tracked. pnpm-lock.yaml was already ignored; npm is the
# documented package manager here, so `npm install` would otherwise leave an
# untracked package-lock.json for the next session to commit by accident.
pnpm-lock.yaml
package-lock.json
dist-kit/
__pycache__/

# Planning artifacts. Skills and CLAUDE.md describe these as on-disk only; the
# rules below make that true. Without them every planning worktree reports a
# permanently dirty tree, which the worktree-lifecycle cleanup treats as
# terminal (#254).
PLAN.md
PLAN-REVIEW-LOG.md
ANNAHMEN.md

# Worktree roots. A sibling worktree is a full checkout living inside this one,
# so leaving it visible is not neutral: `npm pack` packs it (616 of 999 files in
# one measured tarball were worktree contents), and a wholesale `git add` commits
# it as an embedded repository (#370).
#
# These entries were briefly removed after teardown deleted a live sibling
# worktree, on the reasoning that a blocked landing beats a deleted one. That was
# the right call while the cause was open and the wrong one afterwards: teardown
# now resolves its target before removing anything and never treats a main
# checkout as scratch (#385, 0.45.2), so ignoring these no longer arms a
# deletion — while leaving them visible does arm a publish.
.worktrees/
.claude/worktrees/

# Tool and prototype scratch written into the repository root.
.playwright-mcp/
variant-*.png

# Local Claude/Codex state and personal overrides. Checked-in skills, project
# config, hooks, and agent definitions remain trackable.
.claude/settings.local.json
.claude/settings.local.json.backup
.codex/*.local.toml
.codex/agents/*.local.toml
.codex/auth.json
.codex/history.jsonl
.codex/session-*.jsonl
.codex/logs/
.codex/cache/
.codex/tmp/
.codex-log/

.claude/logs/
